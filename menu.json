    "Pause": {
      "Title": "PAUSED",
      "Items": [
        { "Type": "Button", "Text": "Resume", "Function": "Resume" },
        { "Type": "Button", "Text": "Restart", "Function": "Restart" },
        { "Type": "Button", "Text": "Options", "Function": "OpenMenu", "Target": "Options" },
        { "Type": "Button", "Text": "Main Menu", "Function": "MainMenu" },
        { "Type": "Button", "Text": "Exit", "Function": "ExitGame" }
      ]
    }
  }
}
